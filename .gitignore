# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE Specific Files/Directories
.idea
.vscode
*.iml
*.DS_Store

# Dependency directories
frontend/node_modules
backend/node_modules

# Coverage info
/coverage
**/*/coverage

# Production
frontend/build
backend/dist

# Env files
*.env
backend/.env.local

# TypeScript automatic files
backend/*.tsbuildinfo

# Package manager
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Yarn lock
tmp